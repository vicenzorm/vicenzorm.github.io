---
interface Props {
  title: string;
  tagline: string;
  year: string;
  href: string;
}
const { title, tagline, year, href } = Astro.props;
---
<li>
  <a class="row" href={href}>
    <span class="row__title">{title}</span>
    <span class="row__tagline">{tagline}</span>
    <span class="row__year">{year}</span>
  </a>
</li>
