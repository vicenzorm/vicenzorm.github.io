---
interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  appIds?: string[];
  noindex?: boolean;
}
const { title, description, type = 'website', appIds = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteUrl = new URL('/', canonical).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Vicenzo Ribas Másera',
  url: siteUrl,
  jobTitle: 'iOS Engineer',
  email: 'vicenzomasera@icloud.com',
  sameAs: [
    'https://github.com/vicenzorm',
    'https://linkedin.com/in/vicenzomasera',
  ],
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Pontifical Catholic University of Rio Grande do Sul',
  },
  knowsAbout: [
    'Swift', 'SwiftUI', 'UIKit', 'The Composable Architecture',
    'Swift Concurrency', 'CoreML', 'HealthKit', 'SwiftData',
    'App Intents', 'WidgetKit', 'SpriteKit', 'iOS development',
    'macOS development',
  ],
};

const contributor = { '@type': 'Person', name: 'Vicenzo Ribas Másera' };

// Keyed by content-collection id, so a page only emits schema for its own app.
const apps: Record<string, object> = {
  shiro: {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Shiro',
    applicationCategory: 'GameApplication',
    operatingSystem: 'iOS',
    url: 'https://apps.apple.com/br/app/shiro/id6752502968',
    contributor,
  },
  'every-minute': {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Every Minute',
    applicationCategory: 'GameApplication',
    operatingSystem: 'visionOS',
    url: 'https://apps.apple.com/us/app/every-minute/id6789366168',
    contributor,
  },
};

const pageApps = appIds.map((id) => apps[id]).filter(Boolean);
---
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={new URL('/og.png', siteUrl).href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Vicenzo Ribas Másera — iOS developer" />
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json" set:html={JSON.stringify(person)} />
{pageApps.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(pageApps)} />}
