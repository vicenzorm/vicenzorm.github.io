---
interface Props {
  org: string;
  role: string;
  dates: string;
}
const { org, role, dates } = Astro.props;
---
<div class="work">
  <div class="work__head">
    <strong>{org}</strong>
    <span class="work__dates">{dates}</span>
  </div>
  <div class="work__role">{role}</div>
  <slot />
</div>
