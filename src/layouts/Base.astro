---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Nav from '../components/Nav.astro';
import bodyWoff from '@fontsource/im-fell-english/files/im-fell-english-latin-400-normal.woff2?url';
import displayWoff from '@fontsource/im-fell-dw-pica/files/im-fell-dw-pica-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  heading: string;
  type?: 'website' | 'article';
  appIds?: string[];
  noindex?: boolean;
}

const { title, description, heading, type = 'website', appIds = [], noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FBFAF8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171614" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Seo title={title} description={description} type={type} appIds={appIds} noindex={noindex} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" as="font" type="font/woff2" href={displayWoff} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyWoff} crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main" tabindex="-1">
      <h1>{heading}</h1>
      <slot />
      <Nav />
    </main>
  </body>
</html>
