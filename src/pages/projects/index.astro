---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectRow from '../../components/ProjectRow.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---
<Base
  title="Projects — Vicenzo Ribas Másera"
  description="Case studies from the Apple Developer Academy, AGES at PUCRS, and solo work."
  heading="Projects"
  appIds={projects.filter((p) => p.data.links.appStore).map((p) => p.id)}
>
  <ul class="row-list">
    {projects.map((p) => (
      <ProjectRow
        title={p.data.title}
        tagline={p.data.tagline}
        year={p.data.year}
        href={`/projects/${p.id}/`}
      />
    ))}
  </ul>
</Base>
